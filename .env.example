# GCP — BigQuery (mission 1)
# Path to service account JSON key file (NOT an API key)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/agentindex-bigquery-sa.json
BQ_DATASET=bigquery-public-data.crypto_ethereum
BQ_MAX_BYTES_BILLED=1073741824

# Mission 2 — ERC-8004 agent probe window (tight bounds; see dev/smoketests/README.md)
BQ_PROBE_START=2026-02-01 05:00:00
BQ_PROBE_END=2026-02-01 06:00:00

# Chain / ENS (later missions)
NETWORKS=1
RPC_URL_1=

# Postgres (later missions)
PG_URL=postgres://agentindex:agentindex@localhost:5432/agentindex

# Sync (later missions)
CONFIRMATIONS=20
SYNC_INTERVAL_CRON=0 */15 * * * *
