# Credentials and runtime overrides only.
# Network targets, registry addresses, and BigQuery tables live in config/default.json.

# GCP: BigQuery service account JSON (NOT an API key)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/agentindex-bigquery-sa.json

# Hard ceiling per capped BigQuery query (sync + ENS discovery)
BQ_MAX_BYTES_BILLED=3221225472

# Optional path to config JSON (default: config/default.json)
# AGENTINDEX_CONFIG=config/default.json
