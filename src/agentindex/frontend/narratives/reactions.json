{
  "overview": {
    "hero": {
      "pulse": [
        {
          "id": "major_registration_spike",
          "priority": 90,
          "when": {
            "all": [
              {"field": "spike_registrations", "op": "gte", "value": 500},
              {"field": "spike_share", "op": "gte", "value": 5}
            ]
          },
          "text": "On {spike_day}, {spike_registrations:,} agents registered ({spike_share:.0f}% of the corpus)."
        },
        {
          "id": "moderate_registration_spike",
          "priority": 70,
          "when": {
            "all": [
              {"field": "spike_registrations", "op": "gte", "value": 100},
              {"field": "spike_vs_median", "op": "gte", "value": 5}
            ]
          },
          "text": "Peak day {spike_day} added {spike_registrations:,} agents ({spike_share:.1f}% of corpus), {spike_vs_median:.0f}× the daily median."
        },
        {
          "id": "sparse_feedback_coverage",
          "priority": 60,
          "when": {"field": "feedback_rate", "op": "lt", "value": 15},
          "text": "Only {feedback_rate:.1f}% of agents ({feedback_events:,} events total) have feedback; registrations outpace reputation activity."
        },
        {
          "id": "healthy_feedback_coverage",
          "priority": 50,
          "when": {"field": "feedback_rate", "op": "gte", "value": 30},
          "text": "{feedback_rate:.1f}% of agents have at least one feedback event across {unique_clients} reviewer wallets."
        },
        {
          "id": "pulse_default",
          "priority": 0,
          "default": true,
          "text": "Daily registration volume and feedback events move independently; spikes in mints do not always coincide with review activity."
        }
      ],
      "score": [
        {
          "id": "coordinated_downvote_day",
          "priority": 90,
          "when": {"field": "coordinated_downvote", "op": "eq", "value": true},
          "text": "On {worst_day}, {worst_events:,} events averaged {worst_mean_score:.2f}, a coordinated low-score burst."
        },
        {
          "id": "high_volume_low_score",
          "priority": 70,
          "when": {"field": "high_volume_low_score", "op": "eq", "value": true},
          "text": "On {worst_day}, {worst_events:,} events averaged {worst_mean_score:.2f}."
        },
        {
          "id": "score_default",
          "priority": 0,
          "default": true,
          "text": "Mean daily score varies with volume; inspect reviewer overlap before trusting aggregate dips."
        }
      ],
      "log": [
        {
          "id": "extreme_spike_concentration",
          "priority": 80,
          "when": {
            "all": [
              {"field": "spike_vs_median", "op": "gte", "value": 20},
              {"field": "top3_share", "op": "gte", "value": 50}
            ]
          },
          "text": "Top 3 days account for {top3_share:.0f}% of agents; peak day is {spike_vs_median:.0f}× the median daily mint rate."
        },
        {
          "id": "moderate_concentration",
          "priority": 50,
          "when": {"field": "top3_share", "op": "gte", "value": 30},
          "text": "Top 3 registration days hold {top3_share:.0f}% of all agents across {registration_days} active days."
        },
        {
          "id": "log_default",
          "priority": 0,
          "default": true,
          "text": "Log scale shows mint volume concentrated in a small number of high-activity days."
        }
      ],
      "cumulative": [
        {
          "id": "stepwise_growth",
          "priority": 80,
          "when": {"field": "top3_share", "op": "gte", "value": 40},
          "text": "Cumulative curve steps up in bursts: top 3 days added {top3_share:.0f}% of agents."
        },
        {
          "id": "cumulative_default",
          "priority": 0,
          "default": true,
          "text": "Agent count grew in discrete jumps rather than steady daily increments."
        }
      ]
    },
    "kpi": {
      "silent_majority": [
        {
          "id": "silent_overwhelming",
          "priority": 80,
          "when": {"field": "silent_pct", "op": "gte", "value": 85},
          "text": "{silent_count:,} agents ({silent_pct:.0f}%) have no feedback on {network_label}."
        },
        {
          "id": "silent_majority",
          "priority": 50,
          "when": {"field": "silent_pct", "op": "gte", "value": 60},
          "text": "{silent_count:,} agents ({silent_pct:.0f}%) remain without feedback."
        },
        {
          "id": "silent_minority",
          "priority": 0,
          "default": true,
          "text": "{silent_count:,} agents ({silent_pct:.0f}%) have no feedback; most agents carry at least one event."
        }
      ],
      "reviewer_economy": [
        {
          "id": "concentrated_reviewers",
          "priority": 70,
          "when": {"field": "events_per_client", "op": "gte", "value": 50},
          "text": "{feedback_events:,} events from {unique_clients} wallets ({events_per_client:.0f} events per client on average)."
        },
        {
          "id": "reviewer_economy_default",
          "priority": 0,
          "default": true,
          "text": "{feedback_events:,} feedback events from {unique_clients} client wallets on {network_label}."
        }
      ],
      "factory_watch": [
        {
          "id": "dominant_factory",
          "priority": 80,
          "when": {
            "all": [
              {"field": "factory_exists", "op": "eq", "value": true},
              {"field": "top_owner_share", "op": "gte", "value": 20}
            ]
          },
          "text": "Top factory wallet minted {top_owner_count:,} agents ({top_owner_share:.0f}% of registry)."
        },
        {
          "id": "factory_present",
          "priority": 50,
          "when": {"field": "factory_exists", "op": "eq", "value": true},
          "text": "Largest factory wallet minted {top_owner_count:,} agents ({top_owner_share:.1f}% of registry)."
        },
        {
          "id": "no_factory",
          "priority": 0,
          "default": true,
          "text": "No wallet minted 50+ agents in this slice."
        }
      ],
      "ens_verified": [
        {
          "id": "ens_none_linked",
          "priority": 80,
          "when": {"field": "ens_links", "op": "eq", "value": 0},
          "text": "No ENS links in this corpus."
        },
        {
          "id": "ens_low_verification",
          "priority": 60,
          "when": {"field": "ens_verified_rate", "op": "lt", "value": 10},
          "text": "{ens_verified} of {ens_links} ENS links pass ENSIP-25 ({ens_verified_rate:.1f}% verification rate)."
        },
        {
          "id": "ens_solid_verification",
          "priority": 50,
          "when": {"field": "ens_verified_rate", "op": "gte", "value": 50},
          "text": "{ens_verified} of {ens_links} ENS links verified on-chain ({ens_verified_rate:.0f}%)."
        },
        {
          "id": "ens_default",
          "priority": 0,
          "default": true,
          "text": "{ens_verified} of {ens_links} ENS links pass ENSIP-25 verification."
        }
      ]
    },
    "score_distribution": {
      "shape_label": [
        {
          "id": "shape_high_skew",
          "priority": 80,
          "when": {
            "all": [
              {"field": "high_bucket_pct", "op": "gte", "value": 50},
              {"field": "low_bucket_count", "op": "gte", "value": 100}
            ]
          },
          "text": "high scores with a heavy low tail"
        },
        {
          "id": "shape_high_dominant",
          "priority": 60,
          "when": {"field": "high_bucket_pct", "op": "gte", "value": 50},
          "text": "skewed toward high scores"
        },
        {
          "id": "shape_balanced",
          "priority": 0,
          "default": true,
          "text": "mixed distribution"
        }
      ],
      "callout": [
        {
          "id": "callout_high_and_low",
          "priority": 80,
          "when": {
            "all": [
              {"field": "high_bucket_pct", "op": "gte", "value": 50},
              {"field": "low_bucket_count", "op": "gte", "value": 50}
            ]
          },
          "text": "{high_bucket_pct:.0f}% of scores are 80–100; {low_bucket_count:,} events fall below 40."
        },
        {
          "id": "callout_high_only",
          "priority": 60,
          "when": {"field": "high_bucket_pct", "op": "gte", "value": 50},
          "text": "{high_bucket_pct:.0f}% of scores sit in the 80–100 bucket."
        },
        {
          "id": "callout_low_tail",
          "priority": 50,
          "when": {"field": "low_bucket_count", "op": "gte", "value": 200},
          "text": "{low_bucket_count:,} events score below 40 despite an otherwise mixed distribution."
        },
        {
          "id": "callout_balanced",
          "priority": 0,
          "default": true,
          "text": "Scores are spread across buckets without one dominant range."
        }
      ]
    },
    "sybil_teaser": {
      "title": [
        {
          "id": "signals_none",
          "priority": 80,
          "when": {"field": "signal_count", "op": "eq", "value": 0},
          "text": "No anomalies flagged"
        },
        {
          "id": "signals_few",
          "priority": 50,
          "when": {"field": "signal_count", "op": "lte", "value": 5},
          "text": "{signal_count} anomalies to review"
        },
        {
          "id": "signals_many",
          "priority": 0,
          "default": true,
          "text": "{signal_count} anomalies need review"
        }
      ],
      "subtitle": [
        {
          "id": "teaser_none",
          "priority": 80,
          "when": {"field": "signal_count", "op": "eq", "value": 0},
          "text": "No factory, burst, collision, or coordinated-review flags in this corpus slice."
        },
        {
          "id": "teaser_default",
          "priority": 0,
          "default": true,
          "text": "Factory wallets, launch bursts, ENS collisions, and coordinated reviews, sorted by severity."
        }
      ]
    }
  },
  "identity": {
    "collision_callout": [
      {
        "id": "verified_collision",
        "priority": 90,
        "when": {
          "all": [
            {"field": "verified_count", "op": "gte", "value": 2},
            {"field": "collision_count", "op": "gte", "value": 2}
          ]
        },
        "tone": "red",
        "icon": "warn",
        "text": "{ens_name} verified by {agent_count} agents."
      },
      {
        "id": "namespace_spray",
        "priority": 70,
        "when": {"field": "collision_count", "op": "gte", "value": 3},
        "tone": "red",
        "icon": "warn",
        "text": "{ens_name} → {agent_count} agents, {verified_count} verified."
      },
      {
        "id": "minor_collision",
        "priority": 40,
        "when": {"field": "collision_count", "op": "gte", "value": 2},
        "tone": "amber",
        "icon": "warn",
        "text": "{ens_name} shared by {agent_count} agents ({verified_count} verified)."
      }
    ],
    "cross_chain": [
      {
        "id": "cross_chain_active",
        "priority": 50,
        "when": {"field": "cross_registrations", "op": "gte", "value": 1},
        "text": "{cross_registrations:,} cross-chain registration refs parsed from token_uri JSON. Scores stay per-chain."
      },
      {
        "id": "cross_chain_none",
        "priority": 0,
        "default": true,
        "text": "No cross-chain registration refs in this corpus slice."
      }
    ]
  },
  "dossier": {
    "primary_callout": [
      {
        "id": "launch_burst",
        "priority": 90,
        "when": {
          "all": [
            {"field": "is_burst", "op": "eq", "value": true},
            {"field": "n", "op": "gte", "value": 20}
          ]
        },
        "tone": "amber",
        "icon": "bolt",
        "title": "Launch burst detected.",
        "text": "{n} reviews within {burst_window_min} minutes of first feedback from {unique_clients} wallets."
      },
      {
        "id": "score_cliff",
        "priority": 85,
        "when": {"field": "cliff", "op": "eq", "value": true},
        "tone": "amber",
        "icon": "flag",
        "title": "High score on a thin sample.",
        "text": "{composite:.1f} composite from {n} reviews."
      },
      {
        "id": "factory_owner",
        "priority": 80,
        "when": {"field": "is_factory", "op": "eq", "value": true},
        "tone": "red",
        "icon": "factory",
        "title": "Factory-owned agent.",
        "text": "Owner minted {owner_count:,} agents."
      },
      {
        "id": "no_feedback",
        "priority": 70,
        "when": {"field": "has_feedback", "op": "eq", "value": false},
        "tone": "blue",
        "icon": "ghost",
        "title": "No reputation signal.",
        "text": "Registered on {network_label} with no feedback events."
      },
      {
        "id": "high_confidence",
        "priority": 60,
        "when": {"field": "confidence_level", "op": "eq", "value": "high"},
        "tone": "green",
        "icon": "info",
        "title": "Stable sample.",
        "text": "{n} reviews from {unique_clients} mostly independent wallets over {span_days} days."
      },
      {
        "id": "low_confidence",
        "priority": 50,
        "when": {"field": "confidence_level", "op": "eq", "value": "low"},
        "tone": "amber",
        "icon": "warn",
        "title": "Low confidence sample.",
        "text": "{n} reviews from {unique_clients} wallets; factory, burst, or reviewer concentration flags apply."
      },
      {
        "id": "medium_confidence",
        "priority": 40,
        "when": {"field": "confidence_level", "op": "eq", "value": "med"},
        "tone": "blue",
        "icon": "info",
        "title": "Mixed signals.",
        "text": "{n} reviews with moderate independence ({independence_pct:.0f}% of reviewers are low-breadth)."
      }
    ],
    "ens_callout": [
      {
        "id": "ens_collision_verified",
        "priority": 90,
        "when": {
          "all": [
            {"field": "is_collision", "op": "eq", "value": true},
            {"field": "verified_count", "op": "gte", "value": 1}
          ]
        },
        "tone": "red",
        "icon": "ens",
        "title": "Verified ENS collision.",
        "text": "Shares {ens_name} with other verified agents."
      },
      {
        "id": "ens_verified",
        "priority": 50,
        "when": {"field": "verified_count", "op": "gte", "value": 1},
        "tone": "green",
        "icon": "verified",
        "title": "ENSIP-25 verified.",
        "text": "{verified_count} on-chain verified name(s)."
      }
    ],
    "confidence_reasons": [
      {
        "id": "no_feedback",
        "priority": 100,
        "when": {"field": "has_feedback", "op": "eq", "value": false},
        "text": "No reputation events recorded"
      },
      {
        "id": "factory_owner",
        "priority": 90,
        "when": {"field": "is_factory", "op": "eq", "value": true},
        "text": "Owner operates a mint factory ({owner_count:,} agents)"
      },
      {
        "id": "single_reviewer",
        "priority": 85,
        "when": {"field": "single_reviewer", "op": "eq", "value": true},
        "text": "Reviews concentrated in few wallets"
      },
      {
        "id": "small_sample",
        "priority": 80,
        "when": {"field": "n", "op": "lt", "value": 5},
        "text": "Very small sample ({n} reviews)"
      },
      {
        "id": "compressed_window",
        "priority": 75,
        "when": {"field": "compressed_burst", "op": "eq", "value": true},
        "text": "Reviews compressed into <1h window"
      },
      {
        "id": "burst_timing",
        "priority": 70,
        "when": {"field": "is_burst", "op": "eq", "value": true},
        "text": "Timing correlation high: {burst_count} reviews in {burst_window_min} min"
      },
      {
        "id": "perfect_thin",
        "priority": 65,
        "when": {"field": "cliff", "op": "eq", "value": true},
        "text": "High score on a thin sample ({n} reviews)"
      },
      {
        "id": "punitive_touch",
        "priority": 60,
        "when": {"field": "punitive_touch", "op": "eq", "value": true},
        "text": "Includes scores from a punitive cluster"
      },
      {
        "id": "moderate_independence",
        "priority": 40,
        "when": {
          "all": [
            {"field": "has_feedback", "op": "eq", "value": true},
            {"field": "independence_pct", "op": "lt", "value": 85}
          ]
        },
        "text": "Moderate reviewer independence"
      },
      {
        "id": "strong_sample",
        "priority": 30,
        "when": {
          "all": [
            {"field": "has_feedback", "op": "eq", "value": true},
            {"field": "confidence_level", "op": "eq", "value": "high"}
          ]
        },
        "text": "{n} reviews from {unique_clients} mostly independent wallets"
      },
      {
        "id": "independence_pct",
        "priority": 10,
        "when": {"field": "has_feedback", "op": "eq", "value": true},
        "text": "Reviewer independence {independence_pct:.0f}%"
      }
    ],
    "flags": {
      "burst": [
        {
          "id": "burst_extreme",
          "priority": 80,
          "when": {"field": "burst_count", "op": "gte", "value": 50},
          "text": "{burst_count} reviews within {burst_window_min} min of first feedback"
        },
        {
          "id": "burst_default",
          "priority": 0,
          "default": true,
          "text": "{burst_count} reviews within {burst_window_min} min of first feedback"
        }
      ],
      "factory": [
        {
          "id": "factory_large",
          "priority": 80,
          "when": {"field": "owner_count", "op": "gte", "value": 200},
          "text": "Owner minted {owner_count:,} agents (large factory)"
        },
        {
          "id": "factory_default",
          "priority": 0,
          "default": true,
          "text": "Owner minted {owner_count:,} agents"
        }
      ],
      "collision": [
        {
          "id": "collision_default",
          "priority": 0,
          "default": true,
          "text": "Shares {ens_name} with another agent"
        }
      ],
      "single": [
        {
          "id": "single_reviewer",
          "priority": 0,
          "default": true,
          "text": "{unique_clients} unique wallets across {n} reviews"
        }
      ],
      "cliff": [
        {
          "id": "cliff_perfect",
          "priority": 80,
          "when": {"field": "composite", "op": "gte", "value": 99.9},
          "text": "{composite:.1f} from {n} reviews (near-perfect on thin sample)"
        },
        {
          "id": "cliff_default",
          "priority": 0,
          "default": true,
          "text": "{composite:.1f} from only {n} reviews"
        }
      ],
      "punitive": [
        {
          "id": "punitive_default",
          "priority": 0,
          "default": true,
          "text": "Reviewed by a known down-scoring cluster"
        }
      ],
      "sparse": [
        {
          "id": "sparse_default",
          "priority": 0,
          "default": true,
          "text": "Only {n} reviews"
        }
      ],
      "ghost": [
        {
          "id": "ghost_default",
          "priority": 0,
          "default": true,
          "text": "Zero reputation events recorded"
        }
      ]
    }
  },
  "reviewer": {
    "archetype": [
      {
        "id": "generous_sprayer",
        "priority": 90,
        "when": {
          "all": [
            {"field": "total_reviews", "op": "gte", "value": 500},
            {"field": "unique_agents", "op": "gte", "value": 500},
            {"field": "avg_score", "op": "gte", "value": 75}
          ]
        },
        "label": "Generous sprayer",
        "tone": "amber",
        "text": "{total_reviews:,} reviews to {unique_agents:,} agents in {span_days} days."
      },
      {
        "id": "punitive_cluster",
        "priority": 85,
        "when": {
          "all": [
            {"field": "total_reviews", "op": "gte", "value": 200},
            {"field": "avg_score", "op": "lte", "value": 15}
          ]
        },
        "label": "Punitive cluster",
        "tone": "red",
        "text": "{total_reviews:,} reviews at avg {avg_score:.1f} over {span_days} days."
      },
      {
        "id": "harsh_critic",
        "priority": 80,
        "when": {
          "all": [
            {"field": "total_reviews", "op": "gte", "value": 100},
            {"field": "avg_score", "op": "lte", "value": 45}
          ]
        },
        "label": "Harsh-critic bot",
        "tone": "amber",
        "text": "{total_reviews:,} reviews averaging {avg_score:.1f}."
      },
      {
        "id": "one_each_broad",
        "priority": 75,
        "when": {
          "all": [
            {"field": "total_reviews", "op": "gte", "value": 50},
            {"field": "agents_per_review", "op": "gte", "value": 0.95},
            {"field": "avg_score", "op": "gte", "value": 80}
          ]
        },
        "label": "One-each broad",
        "tone": "grey",
        "text": "{total_reviews:,} reviews to {unique_agents:,} distinct agents."
      },
      {
        "id": "sequential_burst",
        "priority": 70,
        "when": {
          "all": [
            {"field": "total_reviews", "op": "gte", "value": 30},
            {"field": "sequential_burst", "op": "eq", "value": true}
          ]
        },
        "label": "Sequential burst",
        "tone": "amber",
        "text": "{total_reviews:,} reviews concentrated on consecutive agent IDs."
      },
      {
        "id": "prolific_mixed",
        "priority": 60,
        "when": {"field": "total_reviews", "op": "gte", "value": 100},
        "label": "Prolific mixed",
        "tone": "grey",
        "text": "{total_reviews:,} reviews, avg {avg_score:.1f}, broad coverage with mixed scores."
      },
      {
        "id": "neutral",
        "priority": 0,
        "default": true,
        "label": "Standard reviewer",
        "tone": "grey",
        "text": "{total_reviews:,} reviews across {unique_agents:,} agents at avg {avg_score:.1f}."
      }
    ],
    "independence_callout": [
      {
        "id": "high_timing_low",
        "priority": 80,
        "when": {
          "all": [
            {"field": "is_burst", "op": "eq", "value": true},
            {"field": "high_independence", "op": "eq", "value": true}
          ]
        },
        "tone": "blue",
        "icon": "info",
        "text": "Agent {agent_id}: {independence_pct:.0f}% of reviewers have reviewed ≤3 agents total. Many distinct wallets, but reviews cluster in time."
      },
      {
        "id": "low_independence",
        "priority": 70,
        "when": {"field": "low_independence", "op": "eq", "value": true},
        "tone": "amber",
        "icon": "warn",
        "text": "Agent {agent_id}: {independence_pct:.0f}% of reviewers have reviewed ≤3 agents total."
      }
    ]
  },
  "sybil": {
    "severity_notes": {
      "high": [
        {"id": "sev_high_busy", "priority": 50, "when": {"field": "signal_count", "op": "gte", "value": 10}, "text": "High priority ({signal_count} open signals)"},
        {"id": "sev_high_default", "priority": 0, "default": true, "text": "High priority"}
      ],
      "med": [
        {"id": "sev_med_default", "priority": 0, "default": true, "text": "Review when relevant"}
      ],
      "low": [
        {"id": "sev_low_default", "priority": 0, "default": true, "text": "Informational"}
      ]
    },
    "why_matters": {
      "factory": [
        {
          "id": "why_factory_dominant",
          "priority": 80,
          "when": {"field": "owner_share", "op": "gte", "value": 20},
          "text": "This wallet minted {owner_share:.0f}% of the registry but only {with_feedback} agents have feedback."
        },
        {
          "id": "why_factory_default",
          "priority": 0,
          "default": true,
          "text": "High mint volume from one owner can inflate registry counts without corresponding feedback."
        }
      ],
      "downvote": [
        {
          "id": "why_downvote_severe",
          "priority": 80,
          "when": {"field": "mean_score", "op": "lte", "value": 2},
          "text": "{events:,} events on {day} averaged {mean_score:.2f}, suggesting coordinated down-scoring rather than organic reviews."
        },
        {
          "id": "why_downvote_default",
          "priority": 0,
          "default": true,
          "text": "A single day with many low scores may indicate coordinated activity rather than individual reviews."
        }
