      "reviewer": [
        {
          "id": "why_reviewer_punitive",
          "priority": 80,
          "when": {"field": "avg_score", "op": "lte", "value": 15},
          "text": "This client averaged {avg_score:.1f} across {agents_hit} agents, dragging composites toward zero."
        },
        {
          "id": "why_reviewer_default",
          "priority": 0,
          "default": true,
          "text": "Reviewers that touch hundreds of agents with similar scores behave unlike typical users."
        }
      ],
      "agent": [
        {
          "id": "why_agent_burst",
          "priority": 80,
          "when": {"field": "burst_count", "op": "gte", "value": 50},
